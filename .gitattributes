# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Code, configuration and data files
*.json text eol=lf
*.js text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Media and binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
